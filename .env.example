# Copy to .env and fill in. The .env file is git-ignored — never commit real keys.
# The app works without any key (built-in text templates are used instead of AI).

# Option 1: any OpenAI-compatible provider (example: Runcrate with a DeepSeek model)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.runcrate.ai/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Option 2: Google Gemini (takes priority over Option 1 when set)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Option 3: Groq
# GROQ_API_KEY=
